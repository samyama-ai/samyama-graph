# Options for the samyama service (#2203). Read by
# /usr/lib/systemd/system/samyama.service; an upgrade keeps your edits.
# After a change: sudo systemctl restart samyama
#
# Flags passed to the server, on one line. The defaults listen on 127.0.0.1
# only (RESP 6379, HTTP 8080). To accept connections from other hosts, set up
# authentication first (--auth-file), then for example:
#
#   SAMYAMA_ARGS=--host 0.0.0.0 --auth-file /etc/samyama/auth.toml
SAMYAMA_ARGS=
